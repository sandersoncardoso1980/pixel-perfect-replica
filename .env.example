# Copie para .env (local) e configure as mesmas variáveis na Vercel.
# Nunca coloque valores reais neste arquivo.

# Busca na web (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# Qualificação dos resultados e geração de abordagens (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional. Padrão: gemini-3.8-flash
GEMINI_MODEL=

