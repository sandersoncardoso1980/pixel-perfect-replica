+++ b/src/lib/price-analyses.server.ts
@@ -0,0 +1,53 @@
+import { db } from "./workspace.server";
+import type { AnalysisListItem, PriceAnalysis } from "./price-stats";
+
+// Somente servidor (service role). Guarda cada análise inteira como JSON para reabrir depois.
+
+type Row = {
+  id: string;
+  nicho: string;
+  produto: string;
+  regiao: string;
+  created_at: string;
+  resultado: PriceAnalysis;
+};
+
+export async function saveAnalysis(a: PriceAnalysis): Promise<string> {
+  const { data, error } = await db()
+    .from("analises_preco")
+    .insert({ nicho: a.niche, produto: a.product, regiao: a.region, resultado: { ...a, id: null } })
+    .select("id")
+    .single();
+  if (error) throw new Error(`Falha ao salvar análise: ${error.message}`);
+  return (data as { id: string }).id;
+}
+
+export async function listAnalyses(limit = 30): Promise<AnalysisListItem[]> {
+  const { data, error } = await db()
+    .from("analises_preco")
+    .select("id, nicho, produto, regiao, created_at, resultado")
+    .order("created_at", { ascending: false })
+    .limit(limit);
+  if (error) throw new Error(`Falha ao listar análises: ${error.message}`);
+  return ((data ?? []) as Row[]).map((r) => ({
+    id: r.id,
+    niche: r.nicho,
+    product: r.produto,
+    region: r.regiao,
+    createdAt: r.created_at,
+    n: r.resultado?.stats?.n ?? 0,
+    median: r.resultado?.stats?.median ?? null,
+  }));
+}
+
+export async function getAnalysis(id: string): Promise<PriceAnalysis | null> {
+  const { data, error } = await db()
+    .from("analises_preco")
+    .select("id, resultado, created_at")
+    .eq("id", id)
+    .maybeSingle();
+  if (error) throw new Error(`Falha ao abrir análise: ${error.message}`);
+  if (!data) return null;
+  const row = data as { id: string; resultado: PriceAnalysis; created_at: string };
+  return { ...row.resultado, id: row.id, createdAt: row.created_at };
+}
diff --git a/src/lib/price-search.server.ts b/src/lib/price-search.server.ts
new file mode 100644
index 0000000..7734c80
--- /dev/null
+++ b/src/lib/price-search.server.ts
@@ -0,0 +1,347 @@
+import { createGoogleGenerativeAI } from "@ai-sdk/google";
+import { generateText, Output, streamText } from "ai";
+import { z } from "zod";
+import {
+  buildSummary,
+  computeStats,
+  emptyDropCounts,
+  isGroundedReading,
+  normalizeUrl,
+  priceAppearsInText,
+  selectComparable,
+  formatBRL,
+  type Offer,
+  type PriceAnalysis,
+} from "./price-stats";
+
+// Somente servidor. A IA só LÊ preços que estão escritos nas páginas; toda conta é feita em price-stats.ts.
+
+const FIRECRAWL_SEARCH_URL = "https://api.firecrawl.dev/v2/search";
+const DEFAULT_GEMINI_MODEL = "gemini-2.5-flash";
+const FIRECRAWL_TIMEOUT_MS = 75_000;
+const GEMINI_TIMEOUT_MS = 60_000;
+const MAX_PAGES = 14;
+const RESULTS_PER_QUERY = 8;
+
+export type PriceSearchInput = { niche: string; product: string; region: string };
+
+type WebPage = { url: string; title?: string; description?: string; markdown?: string | null };
+
+const adSchema = z.object({
+  title: z.string(),
+  store: z.string(),
+  price: z.number().nullable(),
+  originalPrice: z.number().nullable(),
+  condition: z.enum(["novo", "usado", "recondicionado", "desconhecida"]),
+  reach: z.enum(["local", "nacional", "marketplace", "desconhecido"]),
+  city: z.string(),
+  relevance: z.number(),
+  evidence: z.string(),
+});
+
+const extractionSchema = z.object({
+  pages: z.array(z.object({ index: z.number().int(), ads: z.array(adSchema).max(5) })),
+});
+
+function statusOf(err: unknown, depth = 0): number | undefined {
+  if (!err || depth > 4) return undefined;
+  const e = err as { statusCode?: unknown; lastError?: unknown; errors?: unknown };
+  if (typeof e.statusCode === "number") return e.statusCode;
+  const fromLast = statusOf(e.lastError, depth + 1);
+  if (fromLast) return fromLast;
+  if (Array.isArray(e.errors)) {
+    for (const x of [...e.errors].reverse()) {
+      const s = statusOf(x, depth + 1);
+      if (s) return s;
+    }
+  }
+  return undefined;
+}
+
+function hostOf(url: string): string {
+  try {
+    return new URL(url).hostname.replace(/^www\./, "");
+  } catch {
+    return url;
+  }
+}
+
+// Mantém o começo da página e os trechos em volta de cada "R$", que é onde os preços estão.
+function priceWindows(md: string, max = 2600): string {
+  const headLen = 900;
+  const parts: string[] = [md.slice(0, headLen)];
+  let covered = headLen;
+  let used = headLen;
+  const re = /R\$\s?\d/g;
+  let m: RegExpExecArray | null;
+  while ((m = re.exec(md)) && used < max) {
+    const end = Math.min(md.length, m.index + 160);
+    if (end <= covered) continue;
+    const start = Math.max(covered, m.index - 140);
+    const seg = md.slice(start, end);
+    parts.push(`… ${seg}`);
+    used += seg.length;
+    covered = end;
+  }
+  return parts.join("\n");
+}
+
+async function firecrawlSearch(
+  query: string,
+  key: string,
+  region: string,
+  warnings: string[],
+  failures: number[],
+): Promise<WebPage[]> {
+  const call = async (withLocation: boolean) =>
+    fetch(FIRECRAWL_SEARCH_URL, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", Authorization: `Bearer ${key}` },
+      body: JSON.stringify({
+        query,
+        limit: RESULTS_PER_QUERY,
+        country: "BR",
+        ...(withLocation ? { location: `${region}, Brazil` } : {}),
+        timeout: 60_000,
+        scrapeOptions: { formats: [{ type: "markdown" }], onlyMainContent: true },
+      }),
+      signal: AbortSignal.timeout(FIRECRAWL_TIMEOUT_MS),
+    });
+
+  try {
+    let r = await call(true);
+    if (r.status === 400) r = await call(false); // região em texto livre pode ser recusada como localização
+    if (!r.ok) {
+      console.error(`[Preços] Firecrawl ${r.status}: ${(await r.text()).slice(0, 200)}`);
+      failures.push(r.status);
+      return [];
+    }
+    const j = (await r.json()) as { data?: { web?: WebPage[] }; warning?: string | null };
+    if (j.warning) warnings.push(`Firecrawl: ${j.warning}`);
+    return j.data?.web ?? [];
+  } catch (e) {
+    console.error(`[Preços] Firecrawl falhou/timeout em "${query}":`, e);
+    failures.push(0);
+    return [];
+  }
+}
+
+function extractionPrompt(input: PriceSearchInput) {
+  return `Você extrai preços de páginas da web para uma pesquisa de preço de mercado.
+Produto pesquisado: "${input.product}"${input.niche ? ` (segmento: ${input.niche})` : ""}. Região de interesse: "${input.region}".
+
+Para cada página numerada, liste até 5 ofertas do produto (ou de equivalentes diretos) com preço ESCRITO no texto. Regras:
+1. Use apenas números que aparecem no texto. Nunca estime, calcule nem converta moeda.
+2. price = preço à vista em reais, como número (ex.: 1299.9). Se só houver parcelas ("10x de R$ 129,90"), NÃO use a parcela: price = null.
+3. originalPrice = preço "de" (riscado) quando houver promoção; caso contrário null.
+4. Para "a partir de", use o valor e escreva "a partir de" na evidência.
+5. relevance de 0 a 1: 1 = mesmo produto (marca, modelo e especificação iguais ao pesquisado); 0.6 = variação próxima; abaixo de 0.4 = acessório, peça, outro produto ou página que não vende.
+6. condition: "usado" para usado/seminovo; "recondicionado" para recondicionado/reembalado; "novo" para novo ou venda de varejo sem indicação de uso; senão "desconhecida".
+7. reach: "local" se for loja física ou negócio da região do usuário; "marketplace" para Mercado Livre, Amazon, Shopee, OLX, Magalu (vendedores terceiros) e similares; "nacional" para e-commerce de alcance nacional; "desconhecido" se não der para saber.
+8. evidence = trecho curto copiado do texto que contém o preço.
+9. store = nome da loja ou vendedor (se não houver, use o domínio).
+10. city = cidade da oferta se estiver no texto, senão "".
+Se a página não tiver preço, devolva ads vazio. Responda em português.`;
+}
+
+async function extractAds(
+  pages: WebPage[],
+  input: PriceSearchInput,
+  geminiKey: string,
+): Promise<z.infer<typeof extractionSchema>> {
+  const google = createGoogleGenerativeAI({ apiKey: geminiKey });
+  const listing = pages
+    .map((p, i) => `[${i}] URL: ${p.url}\nTítulo: ${p.title ?? ""}\nTexto:\n${priceWindows(p.markdown ?? "")}`)
+    .join("\n\n=====\n\n");
+
+  const primary = process.env["GEMINI_MODEL"]?.trim() || DEFAULT_GEMINI_MODEL;
+  const fallbacks = (process.env["GEMINI_FALLBACK_MODELS"] ?? "")
+    .split(",")
+    .map((s) => s.trim())
+    .filter(Boolean);
+  const models = [...new Set([primary, ...fallbacks])];
+
+  let lastStatus: number | undefined;
+  for (const m of models) {
+    let aiError: unknown = null;
+    const res = streamText({
+      abortSignal: AbortSignal.timeout(GEMINI_TIMEOUT_MS),
+      maxRetries: 1,
+      onError: ({ error }) => {
+        aiError = error;
+      },
+      model: google(m),
+      output: Output.object({ schema: extractionSchema }),
+      system: extractionPrompt(input),
+      prompt: listing,
+    });
+    try {
+      return await res.output;
+    } catch (e) {
+      const status = statusOf(aiError) ?? statusOf(e);
+      console.error(`[Preços] Modelo ${m} falhou (status ${status ?? "timeout/rede"}):`, aiError ?? e);
+      if (status === 400 || status === 401 || status === 403) {
+        throw new Error("GEMINI_API_KEY inválida ou sem permissão para o modelo configurado.");
+      }
+      lastStatus = status;
+    }
+  }
+  if (lastStatus === 429) throw new Error("Limite de uso do Gemini atingido. Aguarde um pouco e tente novamente.");
+  if (lastStatus === 503 || lastStatus === 500) {
+    throw new Error("O Gemini está sobrecarregado no momento. Tente novamente em alguns minutos.");
+  }
+  if (lastStatus === 404) throw new Error("Nenhum modelo Gemini encontrado. Verifique GEMINI_MODEL.");
+  throw new Error("A leitura dos preços por IA falhou ou demorou demais. Tente novamente.");
+}
+
+// Leitura opcional em texto. Só é exibida se todos os valores citados existirem nos dados reais.
+async function writeReading(analysis: PriceAnalysis, geminiKey: string): Promise<string | null> {
+  const stats = analysis.stats;
+  if (!stats || stats.n < 3) return null;
+  try {
+    const google = createGoogleGenerativeAI({ apiKey: geminiKey });
+    const model = process.env["GEMINI_MODEL"]?.trim() || DEFAULT_GEMINI_MODEL;
+    const data = {
+      produto: analysis.product,
+      regiao: analysis.region,
+      ofertas: stats.n,
+      lojas: stats.stores,
+      minimo: formatBRL(stats.min),
+      q1: formatBRL(stats.q1),
+      mediana: formatBRL(stats.median),
+      q3: formatBRL(stats.q3),
+      maximo: formatBRL(stats.max),
+      por_alcance: stats.byReach.map((g) => ({
+        alcance: g.reach,
+        ofertas: g.n,
+        minimo: formatBRL(g.min),
+        mediana: formatBRL(g.median),
+      })),
+      confianca: stats.confidence,
+    };
+    const { text } = await generateText({
+      abortSignal: AbortSignal.timeout(GEMINI_TIMEOUT_MS),
+      maxRetries: 1,
+      model: google(model),
+      system:
+        "Você é um analista de preços. Escreva de 2 a 4 frases curtas, em português, com uma leitura do cenário: dispersão dos preços, diferença entre tipos de loja e onde pode haver espaço de posicionamento. Regras: use SOMENTE valores em reais que aparecem nos dados, no formato 'R$ 1.234,56'; não invente números, nomes de lojas nem porcentagens; não use o símbolo %; se a confiança for baixa, diga que é indicativo.",
+      prompt: JSON.stringify(data),
+    });
+    const reading = text.trim();
+    const allowed = [
+      stats.min,
+      stats.q1,
+      stats.median,
+      stats.mean,
+      stats.q3,
+      stats.max,
+      ...stats.byReach.flatMap((g) => [g.min, g.median]),
+    ];
+    if (reading.length > 0 && reading.length <= 800 && isGroundedReading(reading, allowed)) return reading;
+    console.warn("[Preços] Leitura da IA descartada: citava valores fora dos dados.");
+    return null;
+  } catch (e) {
+    console.warn("[Preços] Leitura da IA indisponível:", e);
+    return null;
+  }
+}
+
+export async function analyzePrices(input: PriceSearchInput): Promise<PriceAnalysis> {
+  const firecrawlKey = process.env["FIRECRAWL_API_KEY"]?.trim();
+  const geminiKey = process.env["GEMINI_API_KEY"]?.trim();
+  if (!firecrawlKey || !geminiKey) {
+    throw new Error("Busca na web não configurada. Defina FIRECRAWL_API_KEY e GEMINI_API_KEY.");
+  }
+
+  const warnings: string[] = [];
+  const failures: number[] = [];
+  const dropped = emptyDropCounts();
+
+  const queries = [
+    ...new Set([
+      `${input.product} preço ${input.region}`,
+      `${input.niche ? `${input.niche} ` : ""}${input.product} comprar ${input.region}`,
+    ]),
+  ];
+  console.log("[Preços] Buscando:", queries);
+
+  const found = (await Promise.all(queries.map((q) => firecrawlSearch(q, firecrawlKey, input.region, warnings, failures)))).flat();
+
+  const seen = new Set<string>();
+  const pages = found
+    .filter((p) => p.url && (p.markdown ?? "").length > 80)
+    .filter((p) => {
+      const k = normalizeUrl(p.url);
+      if (seen.has(k)) return false;
+      seen.add(k);
+      return true;
+    })
+    .slice(0, MAX_PAGES);
+
+  if (!pages.length) {
+    if (failures.includes(402)) throw new Error("Os créditos do Firecrawl acabaram. Verifique seu plano no Firecrawl.");
+    if (failures.includes(401)) throw new Error("FIRECRAWL_API_KEY inválida.");
+    if (failures.includes(429)) throw new Error("Muitas buscas seguidas. Aguarde 1 minuto e tente novamente.");
+    if (failures.includes(0)) throw new Error("O Firecrawl não respondeu a tempo. Tente novamente.");
+    if (failures.length) throw new Error("A busca na web falhou. Tente novamente.");
+    warnings.push("A busca não retornou páginas com conteúdo.");
+  }
+
+  const offers: Offer[] = [];
+  if (pages.length) {
+    const extracted = await extractAds(pages, input, geminiKey);
+    for (const pg of extracted.pages) {
+      const page = pages[pg.index];
+      if (!page) continue;
+      const text = page.markdown ?? "";
+      for (const ad of pg.ads) {
+        if (ad.price === null || !Number.isFinite(ad.price) || ad.price <= 0) {
+          dropped.sem_preco++;
+          continue;
+        }
+        // Barreira contra preço inventado: o valor precisa estar escrito na página.
+        if (!priceAppearsInText(ad.price, text)) {
+          dropped.sem_evidencia++;
+          continue;
+        }
+        const originalPrice =
+          ad.originalPrice !== null && ad.originalPrice > ad.price && priceAppearsInText(ad.originalPrice, text)
+            ? ad.originalPrice
+            : null;
+        offers.push({
+          store: ad.store.trim() || hostOf(page.url),
+          title: ad.title.trim(),
+          price: ad.price,
+          originalPrice,
+          condition: ad.condition,
+          reach: ad.reach,
+          city: ad.city.trim(),
+          relevance: Math.max(0, Math.min(1, ad.relevance)),
+          url: page.url,
+          evidence: ad.evidence.trim().slice(0, 240),
+        });
+      }
+    }
+  }
+
+  const { kept, dropped: droppedSelect } = selectComparable(offers);
+  for (const k of Object.keys(droppedSelect) as (keyof typeof dropped)[]) dropped[k] += droppedSelect[k];
+
+  const stats = computeStats(kept);
+  const analysis: PriceAnalysis = {
+    id: null,
+    niche: input.niche,
+    product: input.product,
+    region: input.region,
+    createdAt: new Date().toISOString(),
+    pagesScanned: pages.length,
+    offers: kept,
+    droppedCounts: dropped,
+    stats,
+    summary: buildSummary(stats, dropped, input.product, input.region),
+    reading: null,
+    warnings,
+  };
+  analysis.reading = await writeReading(analysis, geminiKey);
+  return analysis;
+}
diff --git a/src/lib/price-stats.ts b/src/lib/price-stats.ts
new file mode 100644
index 0000000..0b4134f
--- /dev/null
+++ b/src/lib/price-stats.ts
@@ -0,0 +1,351 @@
+// Núcleo da análise de preços. Código puro (sem rede, sem IA), seguro para o navegador e o servidor.
+// Toda estatística que o usuário vê sai daqui, nunca de um modelo de IA.
+
+export type Condition = "novo" | "usado" | "recondicionado" | "desconhecida";
+export type Reach = "local" | "nacional" | "marketplace" | "desconhecido";
+
+export type Offer = {
+  store: string;
+  title: string;
+  price: number;
+  originalPrice: number | null;
+  condition: Condition;
+  reach: Reach;
+  city: string;
+  relevance: number;
+  url: string;
+  evidence: string;
+};
+
+export type DropReason =
+  | "sem_preco"
+  | "sem_evidencia"
+  | "baixa_relevancia"
+  | "usado"
+  | "duplicada"
+  | "fora_da_curva";
+
+export type DropCounts = Record<DropReason, number>;
+
+export type Bin = { from: number; to: number; count: number };
+export type ReachStat = { reach: Reach; n: number; min: number; median: number };
+export type Confidence = "baixa" | "media" | "alta";
+
+export type PriceStats = {
+  n: number;
+  stores: number;
+  min: number;
+  q1: number;
+  median: number;
+  mean: number;
+  q3: number;
+  max: number;
+  bins: Bin[];
+  byReach: ReachStat[];
+  promo: { n: number; avgDiscountPct: number | null };
+  cheapest: Offer;
+  confidence: Confidence;
+};
+
+export type PriceAnalysis = {
+  id: string | null;
+  niche: string;
+  product: string;
+  region: string;
+  createdAt: string;
+  pagesScanned: number;
+  offers: Offer[];
+  droppedCounts: DropCounts;
+  stats: PriceStats | null;
+  summary: string[];
+  reading: string | null;
+  warnings: string[];
+};
+
+export type AnalysisListItem = {
+  id: string;
+  niche: string;
+  product: string;
+  region: string;
+  createdAt: string;
+  n: number;
+  median: number | null;
+};
+
+export const DROP_LABELS: Record<DropReason, string> = {
+  sem_preco: "sem preço claro",
+  sem_evidencia: "preço não confirmado no texto da página",
+  baixa_relevancia: "produto diferente ou acessório",
+  usado: "usado ou recondicionado",
+  duplicada: "repetida",
+  fora_da_curva: "preço muito fora da faixa",
+};
+
+export function emptyDropCounts(): DropCounts {
+  return {
+    sem_preco: 0,
+    sem_evidencia: 0,
+    baixa_relevancia: 0,
+    usado: 0,
+    duplicada: 0,
+    fora_da_curva: 0,
+  };
+}
+
+export function round2(n: number): number {
+  return Math.round(n * 100) / 100;
+}
+
+export function quantile(sorted: number[], p: number): number {
+  if (!sorted.length) return Number.NaN;
+  const pos = (sorted.length - 1) * p;
+  const lo = Math.floor(pos);
+  const hi = Math.ceil(pos);
+  const a = sorted[lo] as number;
+  const b = sorted[hi] as number;
+  return a + (b - a) * (pos - lo);
+}
+
+export function formatBRL(n: number): string {
+  const cents = Math.round(n * 100);
+  const int = Math.floor(Math.abs(cents) / 100);
+  const frac = String(Math.abs(cents) % 100).padStart(2, "0");
+  const dots = String(int).replace(/\B(?=(\d{3})+(?!\d))/g, ".");
+  return `${cents < 0 ? "-" : ""}R$ ${dots},${frac}`;
+}
+
+// Formas como um preço costuma aparecer escrito em páginas brasileiras.
+export function brVariants(price: number): string[] {
+  const cents = Math.round(price * 100);
+  const int = Math.floor(cents / 100);
+  const frac = String(cents % 100).padStart(2, "0");
+  const dots = String(int).replace(/\B(?=(\d{3})+(?!\d))/g, ".");
+  const set = new Set<string>([`${dots},${frac}`, `${int},${frac}`]);
+  if (frac === "00") {
+    set.add(dots);
+    set.add(String(int));
+  }
+  return [...set];
+}
+
+// Confere se o preço extraído realmente aparece no texto da página (barra preço inventado pela IA).
+export function priceAppearsInText(price: number, text: string): boolean {
+  return brVariants(price).some((v) => {
+    const escaped = v.replace(/[.,]/g, "\\$&");
+    const re = new RegExp(`(?<![\\d.,])${escaped}(?!\\d|,\\d|\\.\\d)`);
+    return re.test(text);
+  });
+}
+
+export function normalizeUrl(raw: string): string {
+  try {
+    const u = new URL(raw);
+    return `${u.hostname.replace(/^www\./, "")}${u.pathname.replace(/\/+$/, "")}`.toLowerCase();
+  } catch {
+    return raw.toLowerCase();
+  }
+}
+
+export function normalizeStore(name: string): string {
+  return name
+    .toLowerCase()
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .replace(/[^a-z0-9]+/g, " ")
+    .trim();
+}
+
+export type SelectOptions = { minRelevance?: number; allowUsed?: boolean };
+
+// Escolhe as ofertas comparáveis e conta por que descartou as demais.
+export function selectComparable(
+  offers: Offer[],
+  options: SelectOptions = {},
+): { kept: Offer[]; dropped: DropCounts } {
+  const { minRelevance = 0.6, allowUsed = false } = options;
+  const dropped = emptyDropCounts();
+  const seen = new Set<string>();
+  let kept: Offer[] = [];
+
+  for (const o of offers) {
+    if (!Number.isFinite(o.price) || o.price <= 0) {
+      dropped.sem_preco++;
+      continue;
+    }
+    if (o.relevance < minRelevance) {
+      dropped.baixa_relevancia++;
+      continue;
+    }
+    if (!allowUsed && (o.condition === "usado" || o.condition === "recondicionado")) {
+      dropped.usado++;
+      continue;
+    }
+    const key = `${normalizeUrl(o.url)}|${round2(o.price)}`;
+    if (seen.has(key)) {
+      dropped.duplicada++;
+      continue;
+    }
+    seen.add(key);
+    kept.push(o);
+  }
+
+  // Corta preços absurdos (ex.: um kit de 10 unidades ou um erro de leitura) quando há amostra suficiente.
+  if (kept.length >= 5) {
+    const sorted = kept.map((o) => o.price).sort((a, b) => a - b);
+    const q1 = quantile(sorted, 0.25);
+    const q3 = quantile(sorted, 0.75);
+    const median = quantile(sorted, 0.5);
+    const margin = Math.max(1.5 * (q3 - q1), 0.3 * median);
+    const low = q1 - margin;
+    const high = q3 + margin;
+    const inside = kept.filter((o) => o.price >= low && o.price <= high);
+    dropped.fora_da_curva += kept.length - inside.length;
+    kept = inside;
+  }
+
+  kept.sort((a, b) => a.price - b.price);
+  return { kept, dropped };
+}
+
+export function histogram(values: number[], bins = 6): Bin[] {
+  if (!values.length) return [];
+  const min = Math.min(...values);
+  const max = Math.max(...values);
+  if (min === max) return [{ from: round2(min), to: round2(max), count: values.length }];
+  const width = (max - min) / bins;
+  const out: Bin[] = Array.from({ length: bins }, (_, i) => ({
+    from: round2(min + i * width),
+    to: round2(min + (i + 1) * width),
+    count: 0,
+  }));
+  for (const v of values) {
+    const i = Math.min(bins - 1, Math.floor((v - min) / width));
+    (out[i] as Bin).count++;
+  }
+  return out;
+}
+
+function confidenceOf(n: number, stores: number): Confidence {
+  const base: Confidence = n < 5 ? "baixa" : n < 12 ? "media" : "alta";
+  if (stores < 3 && base === "alta") return "media";
+  if (stores < 3 && base === "media") return "baixa";
+  return base;
+}
+
+export function computeStats(kept: Offer[]): PriceStats | null {
+  if (!kept.length) return null;
+  const prices = kept.map((o) => o.price).sort((a, b) => a - b);
+  const stores = new Set(kept.map((o) => normalizeStore(o.store) || normalizeUrl(o.url))).size;
+
+  const groups = new Map<Reach, number[]>();
+  for (const o of kept) groups.set(o.reach, [...(groups.get(o.reach) ?? []), o.price]);
+  const byReach: ReachStat[] = [...groups.entries()]
+    .map(([reach, list]) => {
+      const s = [...list].sort((a, b) => a - b);
+      return {
+        reach,
+        n: s.length,
+        min: round2(s[0] as number),
+        median: round2(quantile(s, 0.5)),
+      };
+    })
+    .sort((a, b) => b.n - a.n);
+
+  const promos = kept.filter((o) => o.originalPrice !== null && o.originalPrice > o.price);
+  const avgDiscountPct = promos.length
+    ? Math.round(
+        (promos.reduce((acc, o) => acc + ((o.originalPrice as number) - o.price) / (o.originalPrice as number), 0) /
+          promos.length) *
+          1000,
+      ) / 10
+    : null;
+
+  return {
+    n: prices.length,
+    stores,
+    min: round2(prices[0] as number),
+    q1: round2(quantile(prices, 0.25)),
+    median: round2(quantile(prices, 0.5)),
+    mean: round2(prices.reduce((a, b) => a + b, 0) / prices.length),
+    q3: round2(quantile(prices, 0.75)),
+    max: round2(prices[prices.length - 1] as number),
+    bins: histogram(prices),
+    byReach,
+    promo: { n: promos.length, avgDiscountPct },
+    cheapest: [...kept].sort((a, b) => a.price - b.price)[0] as Offer,
+    confidence: confidenceOf(prices.length, stores),
+  };
+}
+
+const REACH_LABEL: Record<Reach, string> = {
+  local: "lojas locais",
+  nacional: "lojas online nacionais",
+  marketplace: "marketplaces",
+  desconhecido: "lojas de alcance não identificado",
+};
+export const reachLabel = (r: Reach): string => REACH_LABEL[r];
+
+// Resumo determinístico: só frases montadas com os números calculados acima.
+export function buildSummary(
+  stats: PriceStats | null,
+  dropped: DropCounts,
+  product: string,
+  region: string,
+): string[] {
+  const out: string[] = [];
+  if (!stats) {
+    out.push(`Não encontramos ofertas comparáveis de "${product}" em páginas públicas para ${region}.`);
+  } else {
+    out.push(
+      `Encontramos ${stats.n} oferta${stats.n === 1 ? "" : "s"} comparáve${stats.n === 1 ? "l" : "is"} de "${product}" em ${stats.stores} loja${stats.stores === 1 ? "" : "s"} (busca para ${region}).`,
+    );
+    out.push(
+      `Preço típico (mediana): ${formatBRL(stats.median)}. Faixa: ${formatBRL(stats.min)} a ${formatBRL(stats.max)}; metade das ofertas fica entre ${formatBRL(stats.q1)} e ${formatBRL(stats.q3)}.`,
+    );
+    out.push(`Oferta mais barata: ${stats.cheapest.store} por ${formatBRL(stats.cheapest.price)}.`);
+    if (stats.promo.n > 0) {
+      out.push(
+        `${stats.promo.n} oferta${stats.promo.n === 1 ? "" : "s"} em promoção${stats.promo.avgDiscountPct !== null ? `, com desconto médio de ${String(stats.promo.avgDiscountPct).replace(".", ",")}%` : ""}.`,
+      );
+    }
+    const local = stats.byReach.find((g) => g.reach === "local");
+    const others = stats.byReach.filter((g) => g.reach !== "local" && g.reach !== "desconhecido");
+    if (local && others.length) {
+      const total = others.reduce((a, g) => a + g.n, 0);
+      out.push(
+        `${reachLabel("local")[0]!.toUpperCase()}${reachLabel("local").slice(1)}: mediana de ${formatBRL(local.median)} (${local.n} oferta${local.n === 1 ? "" : "s"}). Online (nacionais e marketplaces): ${total} oferta${total === 1 ? "" : "s"}, a partir de ${formatBRL(Math.min(...others.map((g) => g.min)))}.`,
+      );
+    }
+    if (stats.confidence === "baixa") {
+      out.push("Poucas ofertas ou poucas lojas: trate o resultado como indicativo, não como média de mercado.");
+    }
+  }
+  const droppedTotal = Object.values(dropped).reduce((a, b) => a + b, 0);
+  if (droppedTotal > 0) {
+    const parts = (Object.keys(dropped) as DropReason[])
+      .filter((k) => dropped[k] > 0)
+      .map((k) => `${dropped[k]} ${DROP_LABELS[k]}`);
+    out.push(`Resultados descartados: ${parts.join("; ")}.`);
+  }
+  return out;
+}
+
+// Valores em reais citados em um texto (ex.: "R$ 1.299,90").
+export function extractBRLAmounts(text: string): number[] {
+  const out: number[] = [];
+  const re = /R\$\s*(\d{1,3}(?:\.\d{3})*|\d+)(?:,(\d{1,2}))?/g;
+  let m: RegExpExecArray | null;
+  while ((m = re.exec(text))) {
+    const int = Number((m[1] as string).replace(/\./g, ""));
+    const frac = m[2] ? Number(m[2].padEnd(2, "0")) / 100 : 0;
+    out.push(round2(int + frac));
+  }
+  return out;
+}
+
+// Um texto escrito pela IA só é aceito se todo valor em reais citado existir nos dados reais e sem percentuais.
+export function isGroundedReading(text: string, allowed: number[]): boolean {
+  if (text.includes("%")) return false;
+  const set = allowed.map(round2);
+  return extractBRLAmounts(text).every((v) => set.some((a) => Math.abs(a - v) < 0.011));
+}
